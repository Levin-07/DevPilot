# DevPilot Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual secrets.

# ==========================================
# Database (PostgreSQL + pgvector)
# ==========================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Default local PostgreSQL connection:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devpilot?schema=public"

# ==========================================
# Application Settings
# ==========================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# Authentication (NextAuth / Auth.js)
# ==========================================
AUTH_SECRET="devpilot-development-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="devpilot-development-secret-key-change-in-production"

# ==========================================
# AI Pipeline (Prepared for Milestone 4+)
# ==========================================
OPENAI_API_KEY=""
